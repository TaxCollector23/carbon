{
  "name": "@carbon/client",
  "version": "0.1.0",
  "description": "Officially-generated, typed TypeScript/JavaScript client for the Carbon control-plane API. Derived directly from the OpenAPI spec — no hand-written per-endpoint methods.",
  "license": "Apache-2.0",
  "author": "Carbon",
  "homepage": "https://carbon.dev",
  "repository": {
    "type": "git",
    "url": "https://github.com/carbon-dev/carbon.git",
    "directory": "packages/client"
  },
  "keywords": ["carbon", "openapi", "typescript", "sdk", "api-client"],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": ["dist", "src", "README.md"],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "codegen": "openapi-typescript ../../apps/dashboard/lib/openapi.snapshot.json -o src/api-types.gen.ts",
    "build": "tsup src/index.ts --format esm,cjs --dts --sourcemap --clean",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "openapi-fetch": "^0.13.0"
  },
  "devDependencies": {
    "@carbon/config": "workspace:*",
    "openapi-typescript": "^7.13.0",
    "tsup": "^8.3.5",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  },
  "engines": {
    "node": ">=18"
  }
}
