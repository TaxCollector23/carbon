{
  "openapi": "3.0.3",
  "info": {
    "title": "Shopify Admin (curated subset)",
    "version": "2024-01",
    "description": "Curated slice of Shopify's Admin REST API for the Carbon sample gallery. Covers products, variants, orders, customers, fulfillments, and inventory."
  },
  "servers": [{ "url": "https://{shop}.myshopify.com/admin/api/2024-01", "variables": { "shop": { "default": "example" } } }],
  "paths": {
    "/products.json": {
      "get": { "tags": ["products"], "summary": "List products", "responses": { "200": { "description": "ok" } } },
      "post": { "tags": ["products"], "summary": "Create a product", "responses": { "201": { "description": "created" } } }
    },
    "/products/{product_id}.json": {
      "parameters": [{ "name": "product_id", "in": "path", "required": true, "schema": { "type": "integer" } }],
      "get": { "tags": ["products"], "summary": "Retrieve a product", "responses": { "200": { "description": "ok" } } },
      "put": { "tags": ["products"], "summary": "Update a product", "responses": { "200": { "description": "ok" } } },
      "delete": { "tags": ["products"], "summary": "Delete a product", "responses": { "200": { "description": "ok" } } }
    },
    "/products/{product_id}/variants.json": {
      "parameters": [{ "name": "product_id", "in": "path", "required": true, "schema": { "type": "integer" } }],
      "get": { "tags": ["variants"], "summary": "List variants", "responses": { "200": { "description": "ok" } } },
      "post": { "tags": ["variants"], "summary": "Create a variant", "responses": { "201": { "description": "created" } } }
    },
    "/variants/{variant_id}.json": {
      "parameters": [{ "name": "variant_id", "in": "path", "required": true, "schema": { "type": "integer" } }],
      "get": { "tags": ["variants"], "summary": "Retrieve a variant", "responses": { "200": { "description": "ok" } } },
      "put": { "tags": ["variants"], "summary": "Update a variant", "responses": { "200": { "description": "ok" } } },
      "delete": { "tags": ["variants"], "summary": "Delete a variant", "responses": { "200": { "description": "ok" } } }
    },
    "/collections.json": {
      "get": { "tags": ["collections"], "summary": "List collections", "responses": { "200": { "description": "ok" } } }
    },
    "/collections/{collection_id}.json": {
      "parameters": [{ "name": "collection_id", "in": "path", "required": true, "schema": { "type": "integer" } }],
      "get": { "tags": ["collections"], "summary": "Retrieve a collection", "responses": { "200": { "description": "ok" } } }
    },
    "/orders.json": {
      "get": { "tags": ["orders"], "summary": "List orders", "responses": { "200": { "description": "ok" } } },
      "post": { "tags": ["orders"], "summary": "Create an order", "responses": { "201": { "description": "created" } } }
    },
    "/orders/{order_id}.json": {
      "parameters": [{ "name": "order_id", "in": "path", "required": true, "schema": { "type": "integer" } }],
      "get": { "tags": ["orders"], "summary": "Retrieve an order", "responses": { "200": { "description": "ok" } } },
      "put": { "tags": ["orders"], "summary": "Update an order", "responses": { "200": { "description": "ok" } } },
      "delete": { "tags": ["orders"], "summary": "Delete an order", "responses": { "200": { "description": "ok" } } }
    },
    "/orders/{order_id}/close.json": {
      "parameters": [{ "name": "order_id", "in": "path", "required": true, "schema": { "type": "integer" } }],
      "post": { "tags": ["orders"], "summary": "Close an order", "responses": { "200": { "description": "ok" } } }
    },
    "/orders/{order_id}/cancel.json": {
      "parameters": [{ "name": "order_id", "in": "path", "required": true, "schema": { "type": "integer" } }],
      "post": { "tags": ["orders"], "summary": "Cancel an order", "responses": { "200": { "description": "ok" } } }
    },
