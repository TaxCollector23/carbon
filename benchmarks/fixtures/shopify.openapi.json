    },
    "/orders/{order_id}/refunds.json": {
      "parameters": [{ "name": "order_id", "in": "path", "required": true, "schema": { "type": "integer" } }],
      "get": { "tags": ["refunds"], "summary": "List refunds for an order", "responses": { "200": { "description": "ok" } } },
      "post": { "tags": ["refunds"], "summary": "Create a refund", "responses": { "201": { "description": "created" } } }
    },
    "/customers.json": {
      "get": { "tags": ["customers"], "summary": "List customers", "responses": { "200": { "description": "ok" } } },
      "post": { "tags": ["customers"], "summary": "Create a customer", "responses": { "201": { "description": "created" } } }
    },
    "/customers/{customer_id}.json": {
      "parameters": [{ "name": "customer_id", "in": "path", "required": true, "schema": { "type": "integer" } }],
      "get": { "tags": ["customers"], "summary": "Retrieve a customer", "responses": { "200": { "description": "ok" } } },
      "put": { "tags": ["customers"], "summary": "Update a customer", "responses": { "200": { "description": "ok" } } },
      "delete": { "tags": ["customers"], "summary": "Delete a customer", "responses": { "200": { "description": "ok" } } }
    },
    "/customers/search.json": {
      "get": { "tags": ["customers"], "summary": "Search customers", "responses": { "200": { "description": "ok" } } }
    },
    "/inventory_levels.json": {
      "get": { "tags": ["inventory"], "summary": "List inventory levels", "responses": { "200": { "description": "ok" } } }
    },
    "/inventory_levels/set.json": {
      "post": { "tags": ["inventory"], "summary": "Set inventory level", "responses": { "200": { "description": "ok" } } }
    },
    "/inventory_items/{inventory_item_id}.json": {
      "parameters": [{ "name": "inventory_item_id", "in": "path", "required": true, "schema": { "type": "integer" } }],
      "get": { "tags": ["inventory"], "summary": "Retrieve an inventory item", "responses": { "200": { "description": "ok" } } },
      "put": { "tags": ["inventory"], "summary": "Update an inventory item", "responses": { "200": { "description": "ok" } } }
    },
    "/webhooks.json": {
      "get": { "tags": ["webhooks"], "summary": "List webhooks", "responses": { "200": { "description": "ok" } } },
      "post": { "tags": ["webhooks"], "summary": "Create a webhook", "responses": { "201": { "description": "created" } } }
    },
    "/webhooks/{webhook_id}.json": {
      "parameters": [{ "name": "webhook_id", "in": "path", "required": true, "schema": { "type": "integer" } }],
      "delete": { "tags": ["webhooks"], "summary": "Delete a webhook", "responses": { "200": { "description": "ok" } } }
    }
  }
}
