# ---- Web (apps/web) ----
# Marketing site runs on http://localhost:1223 — no env required.

# ---- Dashboard (apps/dashboard) ----
BETTER_AUTH_SECRET=change-me-to-a-long-random-string
BETTER_AUTH_URL=http://localhost:3001

# ---- API (apps/api) ----
NODE_ENV=development
API_HOST=127.0.0.1
API_PORT=4000
DATABASE_URL=postgres://carbon:carbon@127.0.0.1:5432/carbon
# Set DATABASE_PREPARE=false for Neon pooled/PgBouncer URLs if auto-detection
# cannot recognize your pooler hostname.
DATABASE_PREPARE=
# Upstash CLI often prints `redis://...` plus `--tls`; Carbon auto-enables TLS
# for *.upstash.io and also accepts explicit rediss:// URLs.
REDIS_URL=redis://127.0.0.1:6379
STORAGE_ROOT=./.carbon-data
LOG_LEVEL=info
# API key auth: `enforced` requires x-carbon-key on every /v1/* request;
# `disabled` is dev-only.
CARBON_AUTH_MODE=disabled
CARBON_RATE_LIMIT_MAX=120
CARBON_RATE_LIMIT_WINDOW_MS=60000
ALLOWED_ORIGINS=http://localhost:3001,http://localhost:1223
EMBED_WORKERS=false

# ---- Storage (optional durable artifacts) ----
STORAGE_BACKEND=fs
S3_ENDPOINT=
S3_BUCKET=
S3_REGION=auto
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_PREFIX=

# ---- AI (optional; leave unset to run without AI enrichment) ----
CARBON_AI_PROVIDER=openrouter
CARBON_AI_API_KEY=
CARBON_AI_MODEL=anthropic/claude-opus-5
