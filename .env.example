# ---- Web (apps/web) ----
# Marketing site runs on http://localhost:1223 — no env required.

# ---- Dashboard (apps/dashboard) ----
BETTER_AUTH_SECRET=change-me-to-a-long-random-string
BETTER_AUTH_URL=http://localhost:3001

# ---- API (apps/api) ----
NODE_ENV=development
API_HOST=127.0.0.1
API_PORT=4000
DATABASE_URL=postgres://carbon:carbon@127.0.0.1:5432/carbon
# Set DATABASE_PREPARE=false for Neon pooled/PgBouncer URLs if auto-detection
# cannot recognize your pooler hostname.
DATABASE_PREPARE=
# Upstash CLI often prints `redis://...` plus `--tls`; Carbon auto-enables TLS
# for *.upstash.io and also accepts explicit rediss:// URLs.
REDIS_URL=redis://127.0.0.1:6379
STORAGE_ROOT=./.carbon-data
LOG_LEVEL=info
# API key auth: `enforced` requires x-carbon-key on every /v1/* request;
# `disabled` is dev-only.
CARBON_AUTH_MODE=disabled
CARBON_RATE_LIMIT_MAX=120
CARBON_RATE_LIMIT_WINDOW_MS=60000
ALLOWED_ORIGINS=http://localhost:3001,http://localhost:1223
EMBED_WORKERS=false
# /metrics is unauthenticated so Prometheus can scrape it. Set a token to
# require `Authorization: Bearer <token>` when the endpoint is internet-facing.
CARBON_METRICS_TOKEN=
# Hard ceiling on a single request. Keep it below your platform's own gateway
# timeout so Carbon, not the proxy, decides what a timeout looks like.
CARBON_REQUEST_TIMEOUT_MS=30000
# On SIGTERM, keep serving for this long with /ready failing, so the load
# balancer drains before the listener closes. Set 0 if your platform removes
# the instance from the pool before signalling.
CARBON_DRAIN_MS=5000
# Emulators run in the API process; each holds a socket and in-memory state.
CARBON_MAX_EMULATORS=25
# Number of reverse-proxy hops in front of the API. Set to the count of
# proxies you actually run behind (usually 1). 0 (default) ignores XFF so a
# client cannot spoof its IP to reset a rate-limit bucket.
CARBON_TRUSTED_PROXY_HOPS=0
# Serve /docs and /openapi.json without an API key. Defaults to true in dev,
# false in production. Set true only if the spec is meant to be public.
CARBON_PUBLIC_DOCS=
# Comma-separated allow-list of interfaces an emulator may bind to. Add
# `0.0.0.0` here only if emulators should be reachable off-host.
CARBON_EMULATOR_ALLOWED_HOSTS=127.0.0.1,localhost

# ---- Storage (optional durable artifacts) ----
STORAGE_BACKEND=fs
S3_ENDPOINT=
S3_BUCKET=
S3_REGION=auto
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_PREFIX=

# ---- AI (optional; leave unset to run without AI enrichment) ----
CARBON_AI_PROVIDER=openrouter
CARBON_AI_API_KEY=
CARBON_AI_MODEL=anthropic/claude-opus-5
