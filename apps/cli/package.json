{
  "name": "@carbon/cli",
  "version": "0.1.0",
  "private": false,
  "type": "module",
  "bin": { "carbon": "./dist/index.js" },
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "files": ["dist"],
  "scripts": {
    "dev": "tsx src/index.ts",
    "build": "tsup src/index.ts --format esm --dts --clean",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@carbon/core": "workspace:*",
    "@carbon/proxy": "workspace:*",
    "@carbon/sdk": "workspace:*",
    "citty": "^0.1.6",
    "consola": "^3.3.3",
    "picocolors": "^1.1.1"
  },
  "devDependencies": {
    "@carbon/config": "workspace:*",
    "@types/node": "^22.10.0",
    "tsup": "^8.3.5",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
