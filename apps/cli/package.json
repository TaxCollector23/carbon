  },
  "devDependencies": {
    "@carbon/config": "workspace:*",
    "@carbon/core": "workspace:*",
    "@carbon/parser": "workspace:*",
    "@carbon/proxy": "workspace:*",
    "@carbon/sdk": "workspace:*",
    "@types/node": "^22.10.0",
    "tsup": "^8.3.5",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
