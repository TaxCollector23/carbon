{
  "name": "carbon-dev",
  "version": "0.2.1",
  "private": false,
  "description": "Carbon CLI — build stateful API replicas from your specs, recordings, and schemas.",
  "keywords": [
    "carbon",
    "api",
    "mock",
    "openapi",
    "postman",
    "recording",
    "cli"
  ],
  "type": "module",
  "bin": {
    "carbon": "./dist/index.cjs",
    "carbon-dev": "./dist/index.cjs"
  },
  "main": "./dist/index.cjs",
  "files": [
    "dist",
    "README.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "dev": "tsx src/index.ts",
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "citty": "^0.1.6",
    "consola": "^3.3.3",
    "picocolors": "^1.1.1",
    "pino": "^9.5.0",
    "pino-pretty": "^13.0.0"
  },
  "devDependencies": {
    "@carbon/config": "workspace:*",
    "@carbon/core": "workspace:*",
    "@carbon/parser": "workspace:*",
    "@carbon/proxy": "workspace:*",
    "@carbon/sdk": "workspace:*",
    "@types/node": "^22.10.0",
    "tsup": "^8.3.5",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
