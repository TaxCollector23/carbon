{
  "name": "carbon-api",
  "version": "0.1.0",
  "private": false,
  "type": "module",
  "bin": {
    "carbon": "./dist/index.cjs",
    "carbon-api": "./dist/index.cjs"
  },
  "main": "./dist/index.cjs",
  "files": [
    "dist",
    "README.md"
  ],
