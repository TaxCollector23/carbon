{"openapi":"3.1.0","info":{"title":"Carbon API","description":"Control plane for Carbon — projects, ingestion, emulators, snapshots, artifacts, org/billing, and CLI auth. Every endpoint accepts either an API key (`x-carbon-key`) or a Better Auth session cookie/bearer token; the docs and `/health` endpoints are the only routes served anonymously.","version":"dev","contact":{"name":"Carbon","url":"https://carbon.dev","email":"support@carbon.dev"},"license":{"name":"Apache-2.0","url":"https://www.apache.org/licenses/LICENSE-2.0"}},"components":{"securitySchemes":{"apiKey":{"type":"apiKey","in":"header","name":"x-carbon-key","description":"A key minted via `POST /v1/api-keys` or the `bootstrap` script. Prefix `ck_live_*` for production, `ck_test_*` for test envs."},"bearerAuth":{"type":"http","scheme":"bearer","bearerFormat":"better-auth-session","description":"A Better Auth session bearer token. Preferred for programmatic access from a signed-in user."},"sessionCookie":{"type":"apiKey","in":"cookie","name":"better-auth.session_token","description":"The Better Auth session cookie set by the dashboard. Used implicitly when the browser calls the API cross-origin with `credentials: \"include\"`."}},"schemas":{}},"paths":{"/openapi.json":{"get":{"responses":{"200":{"description":"Default Response"}}}},"/metrics":{"get":{"summary":"List /metrics","description":"GET /metrics","responses":{"200":{"description":"Default Response"}}}},"/health":{"get":{"summary":"Liveness probe","tags":["Health"],"description":"Cheap liveness check — returns 200 as long as the process is up. Use as a Kubernetes liveness probe.","responses":{"200":{"description":"Default Response","content":{"application/json":{"schema":{"type":"object","properties":{"ok":{"type":"boolean"},"service":{"type":"string"},"version":{"type":"string"}},"required":["ok","service","version"],"additionalProperties":false}}}}}}},"/v1/health/live":{"get":{"summary":"Liveness probe (versioned)","tags":["Health"],"description":"Versioned alias for `/health`. Identical response shape and cost.","responses":{"200":{"description":"Default Response","content":{"application/json":{"schema":{"type":"object","properties":{"ok":{"type":"boolean"},"service":{"type":"string"},"version":{"type":"string"}},"required":["ok","service","version"],"additionalProperties":false}}}}}}},"/v1/version":{"get":{"summary":"Server version and feature flags","tags":["Health"],"description":"Return the running server version, git SHA (if stamped by CI), uptime, and per-deployment feature toggles.","responses":{"200":{"description":"Default Response","content":{"application/json":{"schema":{"type":"object","properties":{"version":{"type":"string"},"release":{"type":"string"},"node":{"type":"string"},"startedAt":{"type":"string","format":"date-time"},"uptimeSec":{"type":"integer"},"gitSha":{"type":"string","nullable":true},"buildTime":{"type":"string","nullable":true},"plans":{"type":"array","items":{"type":"string"}},"features":{"type":"object","properties":{"billing":{"type":"boolean"},"sso":{"type":"boolean"},"scim":{"type":"boolean"}},"required":["billing","sso","scim"],"additionalProperties":false}},"required":["version","release","node","startedAt","uptimeSec","gitSha","buildTime","plans","features"],"additionalProperties":false}}}}}}},"/ready":{"get":{"summary":"List /ready","tags":["Health"],"description":"GET /ready","responses":{"200":{"description":"Default Response"}}}},"/v1/health/deep":{"get":{"summary":"List /v1/health/deep","tags":["Health"],"description":"GET /v1/health/deep","responses":{"200":{"description":"Default Response"}}}},"/v1/projects":{"get":{"summary":"List projects","tags":["Projects"],"description":"Return projects visible to the caller, ordered by id. Uses a limit+1 cursor pagination scheme; a stable `nextCursor` continues the scan on the next call. `total` is only computed when `includeTotal=true` and only on the first page.","parameters":[{"schema":{"type":"integer","minimum":1,"maximum":100,"default":25},"in":"query","name":"limit","required":false},{"schema":{"type":"string"},"in":"query","name":"cursor","required":false},{"schema":{"type":"string"},"in":"query","name":"orgId","required":false},{"schema":{"type":"boolean","default":false},"in":"query","name":"includeTotal","required":false}],"responses":{"200":{"description":"Default Response","content":{"application/json":{"schema":{"type":"object","properties":{"data":{"type":"array","items":{"type":"object","properties":{"id":{"type":"string"},"orgId":{"type":"string"},"slug":{"type":"string"},"name":{"type":"string"},"createdAt":{"type":"string","format":"date-time"},"updatedAt":{"type":"string","format":"date-time"}},"required":["id","orgId","slug"],"additionalProperties":false}},"nextCursor":{"type":"string","nullable":true},"hasMore":{"type":"boolean"},"total":{"type":"integer","nullable":true}},"required":["data","nextCursor","hasMore","total"],"additionalProperties":false}}}}}},"post":{"summary":"Create a project","tags":["Projects"],"description":"Create a new project under the caller's organization. The slug must be unique per org and follow the same restricted grammar the path-param routes accept.","requestBody":{"required":true,"content":{"application/json":{"schema":{"type":"object","properties":{"orgId":{"type":"string","minLength":1},"slug":{"type":"string","minLength":1,"maxLength":80,"pattern":"^[a-z0-9][a-z0-9-]*$"},"name":{"type":"string","minLength":1,"maxLength":120}},"required":["slug","name"],"additionalProperties":false}}}},"responses":{"201":{"description":"Default Response","content":{"application/json":{"schema":{"type":"object","properties":{"id":{"type":"string"},"orgId":{"type":"string"},"slug":{"type":"string"},"name":{"type":"string"},"createdAt":{"type":"string","format":"date-time"},"updatedAt":{"type":"string","format":"date-time"}},"required":["id","orgId","slug"],"additionalProperties":false}}}}}}},"/v1/projects/{id}":{"get":{"summary":"Get a project","tags":["Projects"],"description":"Look up a single project by id. Returns 404 if the project is not visible to the caller's org.","parameters":[{"schema":{"type":"string"},"in":"path","name":"id","required":true}],"responses":{"200":{"description":"Default Response","content":{"application/json":{"schema":{"type":"object","properties":{"id":{"type":"string"},"orgId":{"type":"string"},"slug":{"type":"string"},"name":{"type":"string"},"createdAt":{"type":"string","format":"date-time"},"updatedAt":{"type":"string","format":"date-time"}},"required":["id","orgId","slug"],"additionalProperties":false}}}}}}},"/v1/projects/{id}/members":{"get":{"summary":"List project members","tags":["Projects"],"description":"Return every explicit ACL row for the project. Absent rows mean the org-wide default access applies.","parameters":[{"schema":{"type":"string"},"in":"path","name":"id","required":true}],"responses":{"200":{"description":"Default Response","content":{"application/json":{"schema":{"type":"object","properties":{"data":{"type":"array","items":{"type":"object","properties":{"id":{"type":"string"},"projectId":{"type":"string"},"userId":{"type":"string"},"role":{"type":"string","enum":["viewer","editor","admin"]},"createdAt":{"type":"string","format":"date-time"}},"required":["id","projectId","userId","role"],"additionalProperties":false}}},"required":["data"],"additionalProperties":false}}}}}},"post":{"summary":"Add a project member","tags":["Projects"],"description":"Grant a specific user access to the project at the requested role. Duplicate calls are idempotent.","requestBody":{"required":true,"content":{"application/json":{"schema":{"type":"object","properties":{"userId":{"type":"string","minLength":1},"role":{"type":"string","enum":["viewer","editor","admin"],"default":"viewer"}},"required":["userId"],"additionalProperties":false}}}},"parameters":[{"schema":{"type":"string"},"in":"path","name":"id","required":true}],"responses":{"201":{"description":"Default Response","content":{"application/json":{"schema":{"type":"object","properties":{"id":{"type":"string"},"projectId":{"type":"string"},"userId":{"type":"string"},"role":{"type":"string","enum":["viewer","editor","admin"]},"createdAt":{"type":"string","format":"date-time"}},"required":["id","projectId","userId","role"],"additionalProperties":false}}}}}}},"/v1/projects/{id}/members/{userId}":{"delete":{"summary":"Delete /v1/projects/:id/members/:userId","tags":["Projects"],"description":"DELETE /v1/projects/:id/members/:userId","parameters":[{"schema":{"type":"string"},"in":"path","name":"id","required":true},{"schema":{"type":"string"},"in":"path","name":"userId","required":true}],"responses":{"200":{"description":"Default Response"}}}},"/v1/projects/{id}/share-links":{"post":{"summary":"Create /v1/projects/:id/share-links","tags":["Share Links"],"description":"POST /v1/projects/:id/share-links","parameters":[{"schema":{"type":"string"},"in":"path","name":"id","required":true}],"responses":{"200":{"description":"Default Response"}}}},"/v1/share-links/{token}/state":{"get":{"summary":"Get /v1/share-links/:token/state","tags":["Share Links"],"description":"GET /v1/share-links/:token/state","parameters":[{"schema":{"type":"string"},"in":"path","name":"token","required":true}],"responses":{"200":{"description":"Default Response"}}}},"/v1/share-links/{id}":{"delete":{"summary":"Delete /v1/share-links/:id","tags":["Share Links"],"description":"DELETE /v1/share-links/:id","parameters":[{"schema":{"type":"string"},"in":"path","name":"id","required":true}],"responses":{"200":{"description":"Default Response"}}}},"/v1/ingest":{"post":{"summary":"Create /v1/ingest","tags":["Ingest"],"description":"POST /v1/ingest","responses":{"200":{"description":"Default Response"}}}},"/v1/ingest/postman":{"post":{"summary":"Create /v1/ingest/postman","tags":["Ingest"],"description":"POST /v1/ingest/postman","responses":{"200":{"description":"Default Response"}}}},"/v1/emulators":{"get":{"summary":"Li