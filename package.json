{
  "name": "carbon",
  "private": true,
  "version": "0.1.0",
  "description": "Carbon — stateful API replicas for development, tests, and CI.",
  "packageManager": "pnpm@11.6.0",
  "engines": {
    "node": ">=20.11.0"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "benchmark:runtime": "tsx benchmarks/runtime-baseline.ts",
    "bench": "pnpm --filter @carbon/benchmarks bench:all",
    "format": "prettier --write \"**/*.{ts,tsx,md,json}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,md,json}\"",
    "test": "vitest run",
    "docs:sdk": "pnpm --filter @carbon/sdk docs",
    "client:codegen": "pnpm --filter @carbon/client codegen",
    "examples:basic": "pnpm --filter @carbon/example-sdk-basic dev",
    "examples:ai": "pnpm --filter @carbon/example-sdk-with-ai dev",
    "examples:vitest": "pnpm --filter @carbon/example-sdk-vitest test",
    "examples:typecheck": "pnpm --filter \"@carbon/example-*\" typecheck",
    "clean": "turbo run clean && rm -rf node_modules"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "prettier": "^3.4.2",
    "prettier-plugin-tailwindcss": "^0.6.9",
    "tsx": "^4.23.8",
    "turbo": "^2.3.3",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
